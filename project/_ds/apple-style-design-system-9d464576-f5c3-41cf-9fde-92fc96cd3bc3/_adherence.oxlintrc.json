{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/commerce/**",
              "components/forms/**",
              "components/navigation/**",
              "components/tiles/**",
              "ui_kits/marketing/**",
              "ui_kits/store/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonDarkUtility'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|key|ref|className|style|children)$/]",
        "message": "<ButtonDarkUtility> doesn't accept that prop. Declared props: children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonIconCircular'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|label|key|ref|className|style|children)$/]",
        "message": "<ButtonIconCircular> doesn't accept that prop. Declared props: children, onClick, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPearlCapsule'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|key|ref|className|style|children)$/]",
        "message": "<ButtonPearlCapsule> doesn't accept that prop. Declared props: children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonPrimary'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|disabled|large|key|ref|className|style|children)$/]",
        "message": "<ButtonPrimary> doesn't accept that prop. Declared props: children, onClick, disabled, large."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonSecondaryPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|key|ref|className|style|children)$/]",
        "message": "<ButtonSecondaryPill> doesn't accept that prop. Declared props: children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfiguratorOptionChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:thumbnail|label|priceDelta|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<ConfiguratorOptionChip> doesn't accept that prop. Declared props: thumbnail, label, priceDelta, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnvironmentQuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|cta|key|ref|className|style|children)$/]",
        "message": "<EnvironmentQuoteCard> doesn't accept that prop. Declared props: eyebrow, title, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingStickyBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|cta|key|ref|className|style|children)$/]",
        "message": "<FloatingStickyBar> doesn't accept that prop. Declared props: price, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: columns."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|brand|key|ref|className|style|children)$/]",
        "message": "<GlobalNav> doesn't accept that prop. Declared props: links, brand."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|title|tagline|primaryCta|secondaryCta|media|key|ref|className|style|children)$/]",
        "message": "<ProductTile> doesn't accept that prop. Declared props: tone, eyebrow, title, tagline, primaryCta, secondaryCta, media."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|parchment|dark|dark-2|dark-3)$/]",
        "message": "<ProductTile> tone must be one of 'light' | 'parchment' | 'dark' | 'dark-2' | 'dark-3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: value, onChange, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreUtilityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|price|cta|onAction|key|ref|className|style|children)$/]",
        "message": "<StoreUtilityCard> doesn't accept that prop. Declared props: image, name, price, cta, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNavFrosted'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|links|cta|key|ref|className|style|children)$/]",
        "message": "<SubNavFrosted> doesn't accept that prop. Declared props: category, links, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|underline|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, underline."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLinkOnDark'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|underline|key|ref|className|style|children)$/]",
        "message": "<TextLinkOnDark> doesn't accept that prop. Declared props: children, href, underline."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
